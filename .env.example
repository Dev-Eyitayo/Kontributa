ENV=development
LOG_LEVEL=INFO


FRONTEND_BASE_URL=http://localhost:3000
# Comma-separated. Blank locally -- the frontend dev server proxies
# through Next.js rewrites instead of calling this API cross-origin, so
# nothing needs it. Deployed, set to the frontend's real origin(s), e.g.
# ALLOWED_ORIGINS=https://kontributa.vercel.app,https://kontributa.app
ALLOWED_ORIGINS=

# --- Database -----------------------------------------------------------

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kontributa


RUNTIME_DATABASE_URL=postgresql+asyncpg://kontributa_app:kontributa_app_password@localhost:5432/kontributa
APP_DB_ROLE=kontributa_app
APP_DB_PASSWORD=kontributa_app_password

# A DIFFERENT database, on purpose. for tests/conftest.py runs
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kontributa_test
TEST_RUNTIME_DATABASE_URL=postgresql+asyncpg://kontributa_app:kontributa_app_password@localhost:5432/kontributa_test

REDIS_URL=redis://localhost:6379/0

# --- Auth -----------------------------------------------------------------
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INACTIVITY_TIMEOUT_MINUTES=30

USE_HTTPONLY_COOKIES=false

EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- Monnify (payments) ----------------------------------------------------
# Sandbox vs live is a config change only -- never a code change.
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_INVOICE_EXPIRY_MINUTES=60
MONNIFY_SOURCE_ACCOUNT_NUMBER=

# --- Paystack (payments) ----------------------------------------------------
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

MONNIFY_SOURCE_ACCOUNT_NUMBER=

# --- Reconciliation job -----------------------------------------------------
RECONCILIATION_INTERVAL_MINUTES=20
RECONCILIATION_PENDING_THRESHOLD_MINUTES=60

# --- Ably (realtime payment confirmation) -----------------------------------
ABLY_API_KEY=

# --- Email Provider (Senviok, etc.) -----------------------------------------
EMAIL_BASE_URL=https://api.senviok.live
EMAIL_API_KEY=svk_live_your_api_key
EMAIL_FROM_EMAIL=noreply@kontributa.app
EMAIL_FROM_NAME=Kontributa

# --- Purse reminders (Phase 7) ----------------------------------------------
# Global kill switch -- set to false to stop reminder sends platform-wide
# without a code change.
REMINDERS_ENABLED=true
REMINDER_MIN_INTERVAL_DAYS=7

# --- Rate limiting -----------------------------------------------------------
# Fixed-window request caps on endpoints that can trigger a SendByte send,
# so a burst of traffic (or abuse) can't quietly exhaust the free tier.
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=5
RATE_LIMIT_REMIND_PER_MINUTE=3

# Consumption-side caps -- guard against brute-forcing a 6-digit code.
RATE_LIMIT_VERIFY_EMAIL_PER_HOUR=20
RATE_LIMIT_RESET_PASSWORD_PER_HOUR=20
